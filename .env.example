# Environment Configuration Example
NEXT_PUBLIC_ENVIRONMENT=development

# WalletConnect Project ID (required)
# Get yours at: https://cloud.walletconnect.com/
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id

# The Graph GraphQL Endpoint used by Graph Client schema generation (required
# until the checked-in API SDL is available). Runtime requests are routed by
# the Graph Client custom transport.
NEXT_PUBLIC_GRAPH_URL=your_graphql_endpoint

# Protected server-to-server Graph query gateway (never prefix these with
# NEXT_PUBLIC_). Browser requests use the same-origin /api/graphql route.
GRAPH_QUERY_GATEWAY_URL=https://your-query-gateway.example/graphql
GRAPH_QUERY_GATEWAY_TOKEN=

# Alchemy API Key (required for Ethereum RPC)
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key

# Filebase IPFS bucket (required for server-side metadata pins)
# Create an IPFS-network bucket at https://filebase.com
FILEBASE_KEY=
FILEBASE_SECRET=
FILEBASE_BUCKET=

# Auction ID (optional)
NEXT_PUBLIC_AUCTION_ID=

# Public URL of the "Web3 Outpost" video shown on the home hero (optional)
# Typically a Vercel Blob URL. When unset the previous Welcome card is rendered.
NEXT_PUBLIC_HERO_VIDEO_URL=

# Snapshot URL (required)
# Format: https://snapshot.box/#/s:your-space.eth
NEXT_PUBLIC_SNAPSHOT_URL=

# Snapshot URL for the SPEC expression-of-feedback space (required)
# Format: https://snapshot.box/#/s:your-space.eth
NEXT_PUBLIC_SNAPSHOT_SPEC_URL=

# PostHog Analytics (optional)
# PostHog Project Token (required if using PostHog)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# PostHog Host URL (optional, defaults to the SDK ingest host such as https://us.i.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=
