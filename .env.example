# Environment Configuration Example
NEXT_PUBLIC_ENVIRONMENT=development

# WalletConnect Project ID (required)
# Get yours at: https://cloud.walletconnect.com/
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id

# The Graph GraphQL Endpoint
# Unified subgraph URL for the deployment's active network (required — also used by graphclient code-gen at build time)
# Use the Sepolia endpoint in development/staging and the Mainnet endpoint in production
NEXT_PUBLIC_GRAPH_URL=your_graphql_endpoint

# Alchemy API Key (required for Ethereum RPC)
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key

# Pinata JWT Token (required for server-side operations)
# Get yours at: https://pinata.cloud/
PINATA_JWT=

# Pinata Gateway URL (required)
# Format: https://your-gateway.mypinata.cloud
NEXT_PUBLIC_PINATA_GATEWAY_URL=

# Auction ID (optional)
NEXT_PUBLIC_AUCTION_ID=

# Snapshot URL (optional)
# Format: https://snapshot.box/#/s:your-space.eth
NEXT_PUBLIC_SNAPSHOT_URL=
