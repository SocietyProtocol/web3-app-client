{
  "name": "society-protocol-client",
  "version": "0.1.0",
  "private": true,
  "description": "Society Protocol - A framework for creating Synchronized Network States. The future of human coordination.",
  "author": "Society Protocol Foundation",
  "license": "MIT",
  "scripts": {
    "dev": "yarn generate:persisted-graphql && GRAPHCLIENT_CODEGEN=1 graphclient build && next dev",
    "build": "yarn generate:persisted-graphql && GRAPHCLIENT_CODEGEN=1 graphclient build && next build",
    "start": "next start",
    "lint": "next lint",
    "codegen": "yarn generate:persisted-graphql && GRAPHCLIENT_CODEGEN=1 graphclient build",
    "generate:persisted-graphql": "node scripts/generate-persisted-graphql.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@mui/material-nextjs": "^7.3.6",
    "@rainbow-me/rainbowkit": "^2.2.9",
    "@tanstack/react-query": "^5.90.17",
    "graphql": "^16.12.0",
    "jotai": "^2.16.1",
    "jotai-tanstack-query": "^0.11.0",
    "next": "16.0.11",
    "notistack": "^3.0.2",
    "nuqs": "^2.8.6",
    "pinata": "^2.5.2",
    "posthog-js": "^1.364.7",
    "react": "19.2.1",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.69.0",
    "react-markdown": "^10.1.0",
    "react-top-loading-bar": "^3.0.2",
    "recharts": "^3.6.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "viem": "^2.39.0",
    "wagmi": "^2.19.4",
    "zod": "^4.3.3"
  },
  "devDependencies": {
    "@graphprotocol/client-cli": "^3.0.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "typescript": "^5",
    "vitest": "^1.0.0"
  },
  "resolutions": {
    "qr": "0.5.5"
  }
}
