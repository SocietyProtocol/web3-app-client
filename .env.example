# Environment Configuration Example
NEXT_PUBLIC_ENVIRONMENT=development

# WalletConnect Project ID (required)
# Get yours at: https://cloud.walletconnect.com/
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id

# The Graph GraphQL Endpoint used by Graph Client schema generation (required
# until the checked-in API SDL is available). Runtime requests are routed by
# the Graph Client custom transport.
NEXT_PUBLIC_GRAPH_URL=your_graphql_endpoint

# Protected server-to-server Graph query gateway (never prefix these with
# NEXT_PUBLIC_). Browser requests use the same-origin /api/graphql route.
GRAPH_QUERY_GATEWAY_URL=https://your-query-gateway.example/graphql
GRAPH_QUERY_GATEWAY_TOKEN=

# Alchemy API Key (required for Ethereum RPC)
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key

# Pimlico bundler and verifying paymaster. Server only. Never NEXT_PUBLIC_.
# The app identity is the Light Account. This key sponsors profile and invite calls.
# Without it (or when sponsorship is refused) the connected wallet pays for those
# calls through its Light Account; the Light Account itself never holds ETH.
PIMLICO_API_KEY=
PIMLICO_SPONSORSHIP_POLICY_ID=sp_eager_ricochet

# Free first badge (optional, off unless "true"). See DEPLOYMENT.md §3.7.
# SPONSOR_FIRST_BADGE=true
# Hours a profile must exist before its free badge (default 6; 0 = no age rule).
# FIRST_BADGE_MIN_PROFILE_AGE_HOURS=6
# Free badges per rolling 24 hours, app-wide per instance (default 20).
# FIRST_BADGE_DAILY_CAP=20
# Separate Pimlico policy with its own low global cap, for free badges only.
# PIMLICO_FIRST_BADGE_POLICY_ID=

# Filebase IPFS bucket (required for server-side metadata pins)
# Create an IPFS-network bucket at https://filebase.com
FILEBASE_KEY=
FILEBASE_SECRET=
FILEBASE_BUCKET=

# Auction ID (optional)
NEXT_PUBLIC_AUCTION_ID=

# Public URL of the "Web3 Outpost" video shown on the home hero (optional)
# Typically a Vercel Blob URL. When unset the previous Welcome card is rendered.
NEXT_PUBLIC_HERO_VIDEO_URL=

# Snapshot URL (required)
# Format: https://snapshot.box/#/s:your-space.eth
NEXT_PUBLIC_SNAPSHOT_URL=

# Snapshot URL for the SPEC expression-of-feedback space (required)
# Format: https://snapshot.box/#/s:your-space.eth
NEXT_PUBLIC_SNAPSHOT_SPEC_URL=

# PostHog Analytics (optional)
# PostHog Project Token (required if using PostHog)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# PostHog Host URL (optional, defaults to the SDK ingest host such as https://us.i.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=

# Browser test suite only (hermetic runs against a local chain). Server only,
# never NEXT_PUBLIC_. Every E2E_* override below is ignored unless
# E2E_HERMETIC=1 AND the app is the suite's own build: built and run with
# NEXT_PUBLIC_ENVIRONMENT=development AND NEXT_PUBLIC_E2E_BUILD=1, which only
# the suite's launcher sets (see src/lib/e2e-build.ts, src/lib/e2e-overrides.ts).
# Leave all of them unset everywhere else, in every deployment's env files.
# E2E_HERMETIC=1
# JSON-RPC endpoint for server-side chain reads, instead of Alchemy
# E2E_RPC_URL=http://127.0.0.1:8545
# Bundler and paymaster endpoint for /api/aa/rpc, instead of Pimlico.
# PIMLICO_API_KEY must still be set to any non-empty value; it is not sent.
# E2E_PIMLICO_UPSTREAM_URL=http://127.0.0.1:4337
# S3-compatible endpoint, instead of Filebase (path-style requests)
# E2E_FILEBASE_ENDPOINT=http://127.0.0.1:9000
# The one build-time value of the suite: milliseconds (50 to 1000) for the
# app's fixed polling and retry waits in the browser, instead of intervals
# sized for a real network (see src/lib/e2e-timing.ts). Compiled into the
# bundle, ignored unless the bundle is the suite's own build (see above).
# Leave unset.
# NEXT_PUBLIC_E2E_POLL_MS=200
